# ── Profile ─────────────────────────────────────────────────
# "dev" = all Gemini   |   "final" = Claude on core reasoning
PROFILE=dev

# ── API Keys (never commit real values) ─────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Claude Model IDs (leave empty until provided from Anthropic Console) ──
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_STRONG=
MAX_TOTAL_CLAUDE_USD=3.50

# ── Grader Model (independent model for evaluations) ────────
GRADER_MODEL=gemini-2.5-flash-lite

# ── Task 1: Knowledge Brain ─────────────────────────────────
T1_API_KEY=change-me-in-production
T1_DB_PATH=task1.db
T1_CHROMA_PATH=chroma_data
T1_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
T1_CRAWL_DELAY=1.0
T1_CRAWL_CONCURRENCY=2
T1_CRAWL_MAX_RETRIES=3
T1_CRAWL_MAX_PAGES=20
T1_HOST=localhost
T1_PORT=8001

# Model names per step (check current names yourself)
T1_RAG_MODEL=gemini-2.5-flash
T1_FALLBACK_MODEL=gemini-flash-latest
T1_IMAGE_MODEL=gemini-2.5-flash
T1_EMBED_MODEL=all-MiniLM-L6-v2

# ── Task 2: Inbox Agent ─────────────────────────────────────
T2_CLASSIFY_MODEL=gemini-2.5-flash
T2_DRAFT_MODEL=gemini-2.5-flash
T1_BASE_URL=http://localhost:8001

# ── Task 3: Meeting to Scope ────────────────────────────────
T3_EXTRACT_MODEL=gemini-2.5-flash
T3_FEASIBILITY_MODEL=gemini-2.5-flash
T3_SCOPE_MODEL=gemini-2.5-flash
T3_ESTIMATE_MODEL=gemini-2.5-flash
T3_PROPOSAL_MODEL=gemini-2.5-flash
T3_HOURLY_RATE=150
T3_CURRENCY=USD
T3_TAX_RATE=0
T3_BASE_URL=http://localhost:8001
